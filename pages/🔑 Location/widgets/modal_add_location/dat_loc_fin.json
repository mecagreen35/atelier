  "onDateSelected": "{{\n  (function() {\n    if (sel_loc_duree.selectedOptionValue !== 'Multi_Jours' || !dat_loc_fin.selectedDate || !dat_loc_debut.selectedDate) return;\n\n    const resas = Get_Calendar_Events_Machine.data || [];\n    const dateDebutStr = moment(dat_loc_debut.selectedDate).format(\"YYYY-MM-DD\");\n    const dateFinStr = moment(dat_loc_fin.selectedDate).format(\"YYYY-MM-DD\");\n\n    const conflit = resas.some(r => {\n      const dateResa = moment(r.Date_Location).format(\"YYYY-MM-DD\");\n      return dateResa >= dateDebutStr && dateResa <= dateFinStr;\n    });\n\n    if (conflit) {\n      // Affiche le message rouge en haut de l'écran\n      showAlert(\"⚠️ Impossible : Ce matériel est déjà réservé sur certaines dates de cette période.\", \"error\");\n    }\n  })()\n}}",
