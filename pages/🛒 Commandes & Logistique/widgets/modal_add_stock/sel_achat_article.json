  "onOptionChange": "{{\n  (async () => {\n    const selectedId = sel_achat_article.selectedOptionValue;\n    const data = Get_Articles_Options.data || [];\n    const art = data.find(a => a.value === selectedId);\n\n    if (art) {\n      // 1. Mémorisation du fournisseur par défaut et du prix d'achat\n      await storeValue('fournisseur_auto_article', art.Fournisseur_Par_Defaut || '');\n      await storeValue('prix_auto_article', art.Prix_Achat || 0);\n      \n      // 2. Réinitialisation du Select Fournisseur pour qu'il relise la valeur par défaut\n      await resetWidget('sel_achat_fournisseur', true);\n    }\n  })()\n}}",
