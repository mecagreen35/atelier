  "onClick": "{{\n  (async function() {\n    try {\n      // 1. On lance la création du BL (le trigger Supabase fait le job)\n      await Transfert_Commande_BL.run();\n      \n      // 2. On va chercher l'ID du BL qui vient d'être créé\n      const result = await Get_Nouveau_BL.run();\n      \n      // 3. On vérifie qu'on a bien l'ID, puis on redirige !\n      if (result && result.length > 0) {\n          const id_nouveau_bl = result[0].ID_BL;\n          navigateTo('Détail Bon de Livraison', { \"id\": id_nouveau_bl }, 'SAME_WINDOW');\n      } else {\n          showAlert(\"Le BL est créé mais impossible de l'ouvrir automatiquement.\", \"warning\");\n      }\n      \n    } catch (error) {\n      showAlert('Erreur lors du transfert : ' + error.message, 'error');\n    }\n  })()\n}}",
