      "itemType": "BUTTON",
      "label": "📝 Créer Devis",
      "menuItems": {},
      "onClick": "{{\n  (async function() {\n    try {\n      const res = await Creer_Devis_Intervention.run();\n      const newId = res?.[0]?.id_devis;\n\n      if (!newId) {\n        showAlert(\"Erreur : identifiant du devis introuvable.\", \"warning\");\n        return;\n      }\n\n      // Mémorisation pour le bouton retour de la page Détail Devis\n      await storeValue('page_precedente', 'Détail Intervention');\n      await storeValue('id_precedent', appsmith.URL.queryParams.id);\n\n      showAlert('Devis créé avec succès !', 'success');\n\n      // Redirection immédiate vers la fiche du devis\n      await navigateTo('Détail Devis', { id: newId });\n    } catch (error) {\n      showAlert('Erreur lors de la création du devis : ' + error.message, 'error');\n    }\n  })()\n}}",
