  "onTabSelected": "{{\n  (async function() {\n    // 1. On mémorise le nouvel onglet\n    await storeValue('tab_atelier_actif', Tabs1.selectedTab);\n    \n    // 2. On rafraîchit SEULEMENT si c'est un onglet de tableau\n    if (Tabs1.selectedTab === \"🛠️ Atelier Global\") {\n      await Get_Atelier_Global.run();\n    } \n    else if (Tabs1.selectedTab !== \"📅 Planning\") {\n      // Si ce n'est ni Global, ni Planning, c'est que c'est l'onglet Perso (David)\n      await Get_Atelier_Perso.run();\n    }\n    // Si c'est \"Planning\", on ne fait rien, le calendrier se charge tout seul !\n  })()\n}}",
