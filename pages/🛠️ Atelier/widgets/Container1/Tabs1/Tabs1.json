  "defaultTab": "{{\n  (() => {\n    const cible = appsmith.store.tab_atelier_actif || \"\";\n\n    // 1. Si on a expressément mémorisé \"Global\"\n    if (cible === \"🛠️ Atelier Global\") {\n      return \"🛠️ Atelier Global\";\n    }\n\n    // 2. Si on a expressément mémorisé \"Planning\"\n    if (cible === \"📅 Planning\") {\n      return \"📅 Planning\";\n    }\n\n    // 3. Si on était sur l'atelier perso (David ou autre)\n    if (cible !== \"\") {\n      // Renvoie exactement le libellé de l'onglet 2 (qu'il soit encore \"Perso\" ou déjà \"David\")\n      return Tabs1.tabsObj.tab2.label;\n    }\n\n    // 4. Première connexion (selon l'adresse email de connexion)\n    if (appsmith.user.email === 'contact@meca-green-motoculture.com') {\n      return \"🛠️ Atelier Global\";\n    } else {\n      return Tabs1.tabsObj.tab2.label;\n    }\n  })()\n}}",
