  "text": "{{\n  (() => {\n    const selectedId = sel_article.selectedOptionValue;\n    if (!selectedId) return \"Prix TTC : —\";\n\n    const art = (Get_Articles_Options.data || []).find(item => item.value === selectedId);\n    if (!art || art.Prix_Vente_TTC == null) return \"Prix TTC : Non renseigné\";\n\n    const prix = Number(art.Prix_Vente_TTC);\n    return \"Prix TTC : \" + prix.toLocaleString('fr-FR', { style: 'currency', currency: 'EUR' });\n  })()\n}}",
