  "renderMode": "CANVAS",
  "responsiveBehavior": "fill",
  "rightColumn": 64,
  "searchKey": "",
  "serverSidePaginationEnabled": true,
  "showInlineEditingOptionDropdown": true,
  "tableData": "{{\n  (() => {\n    // 1. Récupère les données fraîchement chargées ou le cache en mémoire si en cours de chargement\n    const rawData = (Get_Stock_Global.data && Get_Stock_Global.data.length > 0) \n      ? Get_Stock_Global.data \n      : (appsmith.store.cache_stock_global || []);\n\n    const search = (inp_search.text || '').trim().toLowerCase().replace(/\\s+/g, '');\n\n    // Si pas de recherche, on affiche tout le catalogue\n    if (!search) return rawData;\n\n    // 2. Filtrage instantané sur désignation, référence, code-barres et ID\n    return rawData.filter(row => {\n      const des = (row.Designation || '').toLowerCase();\n      const ref = (row.Reference || '').toLowerCase();\n      const cb = (row.Code_Barre || '').toLowerCase().replace(/\\s+/g, '');\n      const id = String(row.ID_Article || '').toLowerCase();\n\n      return des.includes(search) || ref.includes(search) || cb.includes(search) || id.includes(search);\n    });\n  })()\n}}",
  "textSize": "0.875rem",
  "topRow": 6,
  "totalRecordsCount": "1000",
